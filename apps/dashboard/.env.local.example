# Copy to .env.local (pnpm setup does this automatically if it's missing).
NEXT_PUBLIC_API_URL=http://localhost:4000

# Public URL a real embedded widget uses (a real customer's own site,
# not this dashboard) - distinct from NEXT_PUBLIC_API_URL above, which
# is only for the dashboard's own internal traffic. Leave unset for pure
# local dev with no real external embed; set both to a public tunnel or
# real host's URL once one exists (see docs/07's "Widget Production
# Hosting" note and embedSnippet() in app/widget/page.tsx).
NEXT_PUBLIC_WIDGET_API_URL=http://localhost:4000
NEXT_PUBLIC_WIDGET_HOST=https://YOUR-WIDGET-HOST

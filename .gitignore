# Vercel CLI link/pull state (project id, pulled env). Deploys use a
# committed vercel.json + per-project VERCEL_ORG_ID/VERCEL_PROJECT_ID env
# vars instead - see docs/07's widget/dashboard deployment entries.
.vercel/
.vercel

# .history/ is an editor history dump; the *.local snapshots carry real
# production credentials (plaintext .env / credentials files), so the whole
# tree is ignored and the local snapshots are also ignored explicitly.
.history/
.history/*.local
.qodo/

# .claude/ holds the project's engineering framework (agents, skills,
# commands, operators) and is tracked. Only local/runtime state is excluded.
.claude/scheduled_tasks.lock
.claude/settings.local.json

coverage/

# Ad-hoc Playwright verification output (Playwright's own conventional
# directory names) - not a committed test suite, just throwaway output
# from manual/agent verification passes. Screenshots taken during
# verification belong in the scratchpad directory outside the repo, not
# here - this is a safety net, not the primary place they should land.
test-results/
playwright-report/

# Local-only reference docs, not part of the shared repo
docs/Developer_Onboarding_Walkthrough.md
HANDOFF.md
DEPLOYMENT_HANDOFF.md

# --- PostgreSQL ---
# Superuser connection, used only for running migrations (owns all tables).
MIGRATIONS_DATABASE_URL=postgres://postgres:postgres_dev_password@localhost:5433/csa_dev

# app_user: NOSUPERUSER / NOBYPASSRLS. Used by the API for every normal,
# tenant-scoped query. Row Level Security is enforced against this role.
DATABASE_URL=postgres://app_user:app_user_dev_password@localhost:5433/csa_dev

# auth_resolver: NOSUPERUSER / BYPASSRLS, SELECT-only on workspace_api_keys.
# Used by exactly one code path: resolving an incoming widget API key to a
# workspace_id, before any tenant context exists to scope a normal query.
AUTH_RESOLVER_DATABASE_URL=postgres://auth_resolver:auth_resolver_dev_password@localhost:5433/csa_dev

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Auth ---
# openssl rand -base64 48
SESSION_JWT_SECRET=replace-with-a-real-secret-in-every-environment

# --- API ---
API_PORT=4000
API_HOST=0.0.0.0
DASHBOARD_ORIGIN=http://localhost:3000

# --- Embeddings (Phase 2: Knowledge & RAG) ---
# https://dash.voyageai.com - used for knowledge chunk embeddings (voyage-3-lite, 512 dims).
# Optional at boot; ingestion/search return a clear error until this is set.
VOYAGE_API_KEY=
